          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Retry attempts and degraded responses",
      "description": "Both are per-second rates, so they share one axis honestly. A retry spike with no degradation means the retries are winning.",
      "datasource": {
        "type": "prometheus",
        "uid": "module4-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "module4-prom"
          },
          "expr": "sum(rate(retry_attempts_total[1m]))",
          "legendFormat": "retry attempts",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "module4-prom"
          },
          "expr": "sum(rate(degraded_responses_total[1m]))",
          "legendFormat": "degraded responses",
          "refId": "B",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": true,
            "axisGridShow": true,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "retry attempts"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "degraded responses"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B8860B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
